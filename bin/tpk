#!/bin/sh

REPO_BASE="https://raw.githubusercontent.com/andiroyid2025/toinux-repo/main"
APK_MIRROR="http://dl-cdn.alpinelinux.org/alpine/v3.21/main/x86_64"

DB_DIR="/var/lib/tpk"
CACHE_DIR="/var/cache/tpk"
INDEX_FILE="$DB_DIR/index.txt"
INSTALLED_FILE="$DB_DIR/installed.txt"
APK_IDX_DIR="$CACHE_DIR/apk_idx"
APK_INDEX_FILE="$APK_IDX_DIR/APKINDEX"

mkdir -p "$DB_DIR" "$CACHE_DIR" "$APK_IDX_DIR"
touch "$INSTALLED_FILE"

fetch() {
    url="$1"
    out="$2"
    if command -v wget >/dev/null 2>&1; then
        wget -q -T 15 -O "$out" "$url"
        return $?
    elif command -v curl >/dev/null 2>&1; then
        curl -fsSL --max-time 15 -o "$out" "$url"
        return $?
    else
        echo "error: neither wget nor curl found" >&2
        return 1
    fi
}

update_db() {
    echo ":: Synchronizing toinux-repo database..."
    tmp_idx="$CACHE_DIR/index.txt.tmp"
    if fetch "$REPO_BASE/index.txt" "$tmp_idx" && [ -s "$tmp_idx" ]; then
        mv "$tmp_idx" "$INDEX_FILE"
        cnt=$(grep -v '^#' "$INDEX_FILE" | grep -v '^[[:space:]]*$' | wc -l)
        echo ":: toinux-repo synchronized: $cnt packages indexed."
        return 0
    fi
    rm -f "$tmp_idx"
    echo "warning: toinux-repo index unavailable" >&2
    return 1
}

ensure_apk_index() {
    [ -s "$APK_INDEX_FILE" ] && return 0
    echo ":: Fetching Alpine (v3.21/x86_64) package index..."
    tgz_tmp="$CACHE_DIR/APKINDEX.tar.gz"
    if fetch "$APK_MIRROR/APKINDEX.tar.gz" "$tgz_tmp" && [ -s "$tgz_tmp" ]; then
        tar -zxf "$tgz_tmp" -C "$APK_IDX_DIR" 2>/dev/null
        rm -f "$tgz_tmp"
    fi
    [ -s "$APK_INDEX_FILE" ]
}

apk_field() {
    pkg="$1"
    key="$2"
    awk -v p="$pkg" -v k="$key" '
        BEGIN { RS=""; FS="\n" }
        {
            found=0
            for (i=1; i<=NF; i++) {
                if ($i == "P:" p) found=1
            }
            if (found) {
                for (i=1; i<=NF; i++) {
                    if (index($i, k ":") == 1) {
                        print substr($i, length(k) + 2)
                        exit
                    }
                }
            }
        }
    ' "$APK_INDEX_FILE"
}

install_from_apk() {
    pkg="$1"
    ensure_apk_index || { echo "error: could not load Alpine index" >&2; return 1; }

    ver=$(apk_field "$pkg" "V")
    [ -n "$ver" ] || {
        echo "error: package '$pkg' not found in toinux-repo or Alpine index" >&2
        return 1
    }

    apk_name="${pkg}-${ver}.apk"
    apk_path="$CACHE_DIR/$apk_name"
    echo ":: Retrieving $pkg ($ver) from Alpine mirror..."
    if ! fetch "$APK_MIRROR/$apk_name" "$apk_path" || [ ! -s "$apk_path" ]; then
        rm -f "$apk_path"
        echo "error: failed downloading $apk_name" >&2
        return 1
    fi

    echo ":: Unpacking $pkg ($ver) to /..."
    file_list="$DB_DIR/files_${pkg}.list"
    : > "$file_list"
    if tar -zxvf "$apk_path" -C / --exclude='.PKGINFO' --exclude='.SIGN*' 2>&1 | tee "$file_list" | tail -n 10; then
        sed -i "/^${pkg}|/d" "$INSTALLED_FILE" 2>/dev/null || true
        echo "${pkg}|${ver}|apk:$apk_name" >> "$INSTALLED_FILE"
        echo "-> Installed $pkg ($ver)"
        return 0
    fi

    echo "error: failed unpacking $apk_name" >&2
    return 1
}

install_single_raw() {
    pkg="$1"
    [ -s "$INDEX_FILE" ] || update_db || true

    if [ -s "$INDEX_FILE" ]; then
        line=$(grep -E "^${pkg}\|" "$INDEX_FILE" | head -n 1)
        if [ -n "$line" ]; then
            name=$(echo "$line" | cut -d'|' -f1)
            ver=$(echo "$line" | cut -d'|' -f2)
            rel_file=$(echo "$line" | cut -d'|' -f3)
            arc_path="$CACHE_DIR/$(basename "$rel_file")"

            echo ":: Retrieving $name ($ver) from toinux-repo..."
            if fetch "$REPO_BASE/$rel_file" "$arc_path" && [ -s "$arc_path" ]; then
                echo ":: Unpacking $name ($ver) to /..."
                file_list="$DB_DIR/files_${name}.list"
                if tar -zvxf "$arc_path" -C / 2>&1 | tee "$file_list" | tail -n 10; then
                    sed -i "/^${name}|/d" "$INSTALLED_FILE" 2>/dev/null || true
                    echo "${name}|${ver}|${rel_file}" >> "$INSTALLED_FILE"
                    echo "-> Installed $name ($ver)"
                    return 0
                fi
            fi
        fi
    fi

    install_from_apk "$pkg"
}

install_with_deps() {
    root_pkg="$1"
    seen_file="$CACHE_DIR/seen_deps_$$.txt"
    queue_file="$CACHE_DIR/queue_deps_$$.txt"
    : > "$seen_file"
    echo "$root_pkg" > "$queue_file"

    ensure_apk_index || true

    while [ -s "$queue_file" ]; do
        cur=$(head -n 1 "$queue_file")
        sed -i '1d' "$queue_file"
        [ -n "$cur" ] || continue
        grep -qx "$cur" "$seen_file" 2>/dev/null && continue
        echo "$cur" >> "$seen_file"

        if [ -s "$APK_INDEX_FILE" ]; then
            deps_line=$(apk_field "$cur" "D")
            for tok in $deps_line; do
                dep_name=$(printf "%s" "$tok" | sed 's/[<>=~].*//')
                case "$dep_name" in
                    ""|so:*|cmd:*|pc:*|!*|musl|busybox) continue ;;
                esac
                if ! grep -qx "$dep_name" "$seen_file" 2>/dev/null; then
                    echo "$dep_name" >> "$queue_file"
                fi
            done
        fi

        install_single_raw "$cur" || return 1
    done

    rm -f "$seen_file" "$queue_file"
    return 0
}

install_pkgs() {
    [ "$#" -gt 0 ] || { echo "usage: tpk install <pkg1> [pkg2 ...]" >&2; return 1; }
    update_db || true
    total=$#
    idx=0
    for p in "$@"; do
        idx=$((idx + 1))
        echo ""
        echo "[$idx/$total] Resolving & installing '$p' (with dependencies)..."
        install_with_deps "$p" || return 1
    done
    echo ""
    echo ":: Transaction complete."
}

remove_pkg() {
    pkg="$1"
    [ -n "$pkg" ] || { echo "usage: tpk remove <pkg>" >&2; return 1; }
    file_list="$DB_DIR/files_${pkg}.list"
    if [ ! -f "$file_list" ]; then
        echo "error: package not installed: $pkg" >&2
        return 1
    fi
    echo ":: Removing $pkg..."
    while IFS= read -r entry; do
        clean=$(echo "$entry" | sed 's/^\.\///; s/ -> .*//')
        [ -n "$clean" ] || continue
        target="/$clean"
        if [ -f "$target" ] || [ -L "$target" ]; then
            rm -f "$target" 2>/dev/null && echo "   removed $target"
        fi
    done < "$file_list"
    rm -f "$file_list"
    sed -i "/^${pkg}|/d" "$INSTALLED_FILE" 2>/dev/null || true
    echo "-> Removed $pkg"
}

list_pkgs() {
    if [ ! -s "$INSTALLED_FILE" ]; then
        echo "No packages installed via tpk."
        return 0
    fi
    cat "$INSTALLED_FILE"
}

case "${1:-}" in
    update)     update_db ;;
    install)    shift; install_pkgs "$@" ;;
    single-raw) shift; install_single_raw "$1" ;;
    remove)     shift; remove_pkg "$@" ;;
    list)       list_pkgs ;;
    *)
        echo "usage: tpk <update|install|remove|list> [args...]"
        exit 1
        ;;
esac
